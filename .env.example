# Backend Server Configuration
PORT=8080

# Database Configuration (AWS RDS PostgreSQL or Local PostgreSQL)
DATABASE_URL=postgres://token_user:token_password_123@localhost:5432/token_db?sslmode=disable

# Data Encryption Master Key (32-byte string for AES-256 encryption at rest)
AES_KEY=SecureTokenAllocationSecretKey32

# Admin Session HMAC Cookie Signing Secret (32-byte string)
SESSION_SECRET=SuperSecureSessionSecretKey32Bytes

# Initial Super Admin Credentials (used on first run if no Super Admin exists in DB)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin123
